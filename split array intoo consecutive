#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

#define OFFSET 1005  // Padded slightly for extra safety
#define MAP_SIZE 2015 // Padded to comfortably hold values from -1000 to 1000

bool isPossible(int* nums, int numsSize) {
    // Frequency table to count remaining occurrences of each number
    int count[MAP_SIZE] = {0};
    // Frequency table to keep track of subsequences ending at a specific number
    int tails[MAP_SIZE] = {0};

    // Step 1: Populate the initial frequency counts
    for (int i = 0; i < numsSize; i++) {
        count[nums[i] + OFFSET]++;
    }

    // Step 2: Iterate through the elements greedily
    for (int i = 0; i < numsSize; i++) {
        int num = nums[i];
        int idx = num + OFFSET;

        // If this element has already been placed in a subsequence, skip it
        if (count[idx] == 0) {
            continue;
        }

        // Option 1: Try to append this number to an existing subsequence ending at (num - 1)
        // Added safety check (idx > 0) to prevent index -1 out of bounds error
        if (idx > 0 && tails[idx - 1] > 0) {
            count[idx]--;
            tails[idx - 1]--; // Remove the tail ending at num - 1
            tails[idx]++;     // Create a new tail ending at num
        }
        // Option 2: Try to form a brand new valid subsequence of length 3: [num, num+1, num+2]
        else if (idx + 2 < MAP_SIZE && count[idx + 1] > 0 && count[idx + 2] > 0) {
            count[idx]--;
            count[idx + 1]--;
            count[idx + 2]--;
            tails[idx + 2]++; // Create a new tail ending at num + 2
        }
        // Option 3: Neither works, meaning the number cannot form a valid sequence
        else {
            return false;
        }
    }

    return true;
}

