#include <stdlib.h>

// Struct definition for the MinStack object
typedef struct {
    int* data_stack;
    int* min_stack;
    int top_idx;
    int capacity;
} MinStack;

// Initializes the stack object
MinStack* minStackCreate() {
    MinStack* obj = (MinStack*)malloc(sizeof(MinStack));
    obj->capacity = 30000; // Matches max constraint calls
    obj->data_stack = (int*)malloc(sizeof(int) * obj->capacity);
    obj->min_stack = (int*)malloc(sizeof(int) * obj->capacity);
    obj->top_idx = -1;
    return obj;
}

// Pushes the element value onto the stack
void minStackPush(MinStack* obj, int val) {
    obj->top_idx++;
    obj->data_stack[obj->top_idx] = val;
    
    // Calculate current minimum element
    int current_min = val;
    if (obj->top_idx > 0) {
        int previous_min = obj->min_stack[obj->top_idx - 1];
        if (previous_min < current_min) {
            current_min = previous_min;
        }
    }
    obj->min_stack[obj->top_idx] = current_min;
}

// Removes the element on the top of the stack
void minStackPop(MinStack* obj) {
    if (obj->top_idx >= 0) {
        obj->top_idx--;
    }
}

// Gets the top element of the stack
int minStackTop(MinStack* obj) {
    return obj->data_stack[obj->top_idx];
}

// Retrieves the minimum element in the stack
int minStackGetMin(MinStack* obj) {
    return obj->min_stack[obj->top_idx];
}

// Frees memory allocated for the structure
void minStackFree(MinStack* obj) {
    free(obj->data_stack);
    free(obj->min_stack);
    free(obj);
}

