#include <stdlib.h>
#include <string.h>

int findMaxLength(int* nums, int numsSize) {
    if (numsSize <= 1) {
        return 0;
    }

    // The sum can range from -numsSize to +numsSize
    int map_size = 2 * numsSize + 1;
    int offset = numsSize;

    // Allocate lookup table to store the first index where a sum is seen
    int* sum_indices = (int*)malloc(map_size * sizeof(int));
    
    // Initialize all positions to -2 (meaning unseen)
    for (int i = 0; i < map_size; i++) {
        sum_indices[i] = -2;
    }

    // Base case: A sum of 0 effectively occurs at index -1
    sum_indices[0 + offset] = -1;

    int max_len = 0;
    int current_sum = 0;

    for (int i = 0; i < numsSize; i++) {
        // Treat 1 as +1, and 0 as -1
        current_sum += (nums[i] == 1) ? 1 : -1;

        int map_idx = current_sum + offset;

        // If we have seen this running sum before
        if (sum_indices[map_idx] != -2) {
            int len = i - sum_indices[map_idx];
            if (len > max_len) {
                max_len = len;
            }
        } else {
            // Store the first time we see this specific sum
            sum_indices[map_idx] = i;
        }
    }

    // Free the dynamically allocated memory
    free(sum_indices);

    return max_len;
}
