int lengthOfLongestSubstring(char* s) {
    int last_seen[256]; 
    
    // Initialize all ASCII positions to -1
    for (int i = 0; i < 256; i++) {
        last_seen[i] = -1;
    }

    int max_len = 0;
    int start = 0;

    for (int end = 0; s[end] != '\0'; end++) {
        char current_char = s[end];

        // If the character was seen inside the current window, shrink the window
        if (last_seen[(unsigned char)current_char] >= start) {
            start = last_seen[(unsigned char)current_char] + 1;
        }

        // Update the last seen position of the character
        last_seen[(unsigned char)current_char] = end;

        // Calculate and update the maximum window length
        int current_len = end - start + 1;
        if (current_len > max_len) {
            max_len = current_len;
        }
    }

    return max_len;
}
