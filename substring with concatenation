#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define HASH_SIZE 2003

// Structure for tracking word frequencies
typedef struct {
    char* word;
    int count;
} WordFreq;

// Function to find or insert a word in our frequency tracker
int get_word_index(WordFreq* table, int table_size, const char* str, int len) {
    for (int i = 0; i < table_size; i++) {
        if (strncmp(table[i].word, str, len) == 0 && table[i].word[len] == '\0') {
            return i;
        }
    }
    return -1;
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* findSubstring(char* s, char** words, int wordsSize, int* returnSize) {
    *returnSize = 0;
    if (!s || wordsSize == 0) return NULL;

    int s_len = strlen(s);
    int word_len = strlen(words[0]);
    int total_words_len = wordsSize * word_len;

    if (s_len < total_words_len) return NULL;

    // Allocate memory for the maximum possible result indices
    int* result = (int*)malloc(s_len * sizeof(int));
    
    // Step 1: Build a frequency map of the input words array
    WordFreq* word_map = (WordFreq*)calloc(wordsSize, sizeof(WordFreq));
    int unique_words_count = 0;

    for (int i = 0; i < wordsSize; i++) {
        int idx = get_word_index(word_map, unique_words_count, words[i], word_len);
        if (idx != -1) {
            word_map[idx].count++;
        } else {
            word_map[unique_words_count].word = words[i];
            word_map[unique_words_count].count = 1;
            unique_words_count++;
        }
    }

    // Allocate dynamic arrays to track current window frequencies
    int* current_counts = (int*)malloc(unique_words_count * sizeof(int));

    // Step 2: Slide the window over the string
    // We run the loop 'word_len' times to cover all possible character offsets
    for (int i = 0; i < word_len; i++) {
        int start = i;
        int matched_words = 0;
        memset(current_counts, 0, unique_words_count * sizeof(int));

        for (int end = i; end + word_len <= s_len; end += word_len) {
            int idx = get_word_index(word_map, unique_words_count, s + end, word_len);

            if (idx != -1) {
                current_counts[idx]++;
                matched_words++;

                // If a word's count exceeds its expected frequency, shrink window from left
                while (current_counts[idx] > word_map[idx].count) {
                    int left_idx = get_word_index(word_map, unique_words_count, s + start, word_len);
                    current_counts[left_idx]--;
                    matched_words--;
                    start += word_len;
                }

                // Valid match found when all words are perfectly accounted for
                if (matched_words == wordsSize) {
                    result[(*returnSize)++] = start;
                    
                    // Instantly shift window right by one word to keep scanning
                    int left_idx = get_word_index(word_map, unique_words_count, s + start, word_len);
                    current_counts[left_idx]--;
                    matched_words--;
                    start += word_len;
                }
            } else {
                // Invalid word encountered: clear the window data completely
                memset(current_counts, 0, unique_words_count * sizeof(int));
                matched_words = 0;
                start = end + word_len;
            }
        }
    }

    // Clean up allocated memory blocks
    free(word_map);
    free(current_counts);

    return result;
}
